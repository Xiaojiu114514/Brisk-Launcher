# ---------- 构建产物 ----------
build/
target/
out/
*.class

# ---------- 示例插件的构建产物 ----------
examples/**/out/
examples/**/*.jar

# ---------- 缓存 / 工具 ----------
.cache/
.gradle/
.gradle-cache/
local/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# ---------- 运行期数据（绝不提交） ----------
data/
# 只有「安装根目录」的这幾個資料夾是執行期資料；不能寫成 `themes/`，
# 否則會連 src/main/resources/themes（內建主題）一起被忽略。
/logs/
/themes/
/lang/
/plugins/
secret.key
accounts.json
accounts-local.json
launcher.json
acks.json
ui-state.json
versionroots.json
instances.json
*.log
*.tmp
*.part

# ---------- 敏感：微软客户端 ID（构建期注入） ----------
# 真实值放 config/client-id.properties（不入库）；样例文件 client-id.properties.example 入库且留空。
# 构建时由 gradle 的 generateBuildInfo 写进 jar 内的 assets/brisk-build.properties。
# 历史遗留（旧方案）也一起挡住，避免哪天又被塞回来：
config/client-id.properties
config/*.local.properties
!config/client-id.properties.example
src/main/java/com/brisklauncher/mcl/auth/impl/MicrosoftClientIdLocal.java
microsoft-client-id.txt
*.key
*.p12
*.pfx
*.jks

# ---------- 分析/调试产物 ----------
*.sparkprofile
*.hprof
*.jfr
dump-*.txt

# ---------- 审计工具产物 ----------
.acl-recovery/

# ---------- 系统垃圾 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 单 exe 运行期产物 ----------
/runtime/  # 单 exe 释放的 jar
/minecraft/  # 内置游戏目录
instance-id.txt  # 账号实例 id
plugin-trust.json  # 插件信任记录
launcher.lock  # 启动器锁
/data/tmp/  # 临时文件
# ---------- 构建密钥（统一文件） ----------
config/secrets.properties
!config/secrets.properties.example
